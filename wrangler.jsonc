{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wings-of-honor",
  "account_id": "ff58a14821f29f405a29ec9a3eb185a8",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.js",
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/wings-of-honor/api/*",
      "/wings-of-honor/assets/*",
      "/wings-of-honor/fonts/*",
      "/join",
      "/join/",
      "/wings-of-honor/join",
      "/wings-of-honor/join/",
      "/wings",
      "/wings/"
    ]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "supergameslab.com/wings-of-honor*", "zone_name": "supergameslab.com" },
    { "pattern": "www.supergameslab.com/wings-of-honor*", "zone_name": "supergameslab.com" }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supergameslab-wings-of-honor",
      "database_id": "2f793a48-7dbc-4e1f-9815-81b7b394dc47",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LIMITS",
      "id": "a6501088d947435a8893ecc9a01b7a41"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["we.care@supergameslab.com"]
    }
  ],
  "services": [
    { "binding": "PORTAL", "service": "supergameslab" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    }
  ]
}
