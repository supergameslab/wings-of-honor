{
  "name": "wings-of-honor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "npm run build && vite preview --host 0.0.0.0",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "pages:deploy": "npm run build && wrangler pages deploy dist/client --project-name wings-of-honor",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@cloudflare/vite-plugin": "^1.13.16",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.59.1"
  }
}
